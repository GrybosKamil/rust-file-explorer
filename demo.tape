# Output file configuration
Output demo.gif
Output demo.png

# Terminal setup
Set Shell "zsh"
Set FontSize 16
Set Width 900
Set Height 550
Set Padding 15
Set Theme "Catppuccin Macchiato"

# Execution script
Type "fe"
Enter
Sleep 1s

# Navigate down
Down 2
Sleep 800ms

# Start filtering
Type "src"
Sleep 1s

# Clear search with Esc
Escape
Sleep 500ms

# Open src directory
Right
Sleep 1.5s

# Exit application cleanly
Ctrl+C
Sleep 1s